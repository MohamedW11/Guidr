# Copy to .env and adjust as needed:
#   copy .env.example .env

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://guidr:guidr@localhost:5434/guidr

# API server (Replit artifact uses 8080)
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Frontend dev server
VITE_DEV_PORT=3000

# Optional — enables real Groq responses in Guidr Tutor chat
# GROQ_API_KEY=
